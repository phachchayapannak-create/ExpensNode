<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Top Badge Pill -->
    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_pill_badge"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="👑 EXPENSE TRACKER"
        android:textColor="@color/text_pill"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main Card Container -->
    <LinearLayout
        android:id="@+id/cardMain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBadge">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="บันทึกค่าใช้จ่ายประจำวัน ✨"
            android:textColor="@color/text_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="จดทุกบาทที่ใช้วันนี้ จัดไปอย่าให้เสีย 🔥"
            android:textColor="@color/text_subtitle"
            android:textSize="14sp" />

        <!-- Amount Label -->
        <TextView
            android:id="@+id/tvAmountLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="start"
            android:text="💰 ใส่จำนวนเงิน (บาท)"
            android:textColor="@color/text_label"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Amount Input -->
        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="เช่น 100 หรือ 10.25"
            android:inputType="numberDecimal"
            android:padding="14dp"
            android:textColor="@color/text_input"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp" />

        <!-- Note Label -->
        <TextView
            android:id="@+id/tvNoteLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="start"
            android:text="📝 คำอธิบาย"
            android:textColor="@color/text_label"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Note Input -->
        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="เช่น ข้าวกลางวัน, ค่าเดินทาง"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="@color/text_input"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp" />

        <!-- Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="🧹 เคลียร์"
                android:textColor="@color/btn_secondary_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary_gradient"
                android:text="⚡ เพิ่มรายการ"
                android:textColor="@color/btn_primary_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="18dp"
            android:background="@color/divider_color" />

        <!-- Summary Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sub_card"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Latest Item Display -->
            <TextView
                android:id="@+id/tvLatestItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="รายการล่าสุด: -"
                android:textColor="@color/text_latest"
                android:textSize="14sp" />

            <!-- Total Summary Display -->
            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ยอดรวมวันนี้: 0.00 บาท"
                android:textColor="@color/text_total"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>